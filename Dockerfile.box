FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs curl wget ca-certificates gnupg bash openssh-client \
    ripgrep jq less procps psmisc lsof iproute2 tmux sudo cron \
    unzip zip xz-utils file locales lsb-release \
    bubblewrap libseccomp2 uidmap dnsutils fd-find fzf netcat-openbsd rsync \
    build-essential gcc-14 g++-14 make cmake ninja-build pkg-config \
    autoconf automake libtool clang llvm libclang-dev \
    libssl-dev zlib1g-dev libzstd-dev liblz4-dev libsnappy-dev libbz2-dev \
    libpcsclite-dev python3 python3-dev python3-venv python3-pip \
    lcov libgomp1 \
    libfuse2t64 fuse3 libegl1 libopengl0 libglx0 libgl1 libglu1-mesa libvulkan1 \
    libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 \
    libdbus-1-3 fontconfig libfontconfig1 libfreetype6 libnss3 \
    xvfb x11-utils mesa-utils caddy \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 14 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 14 \
    && update-alternatives --set gcc /usr/bin/gcc-14 \
    && update-alternatives --set g++ /usr/bin/g++-14

ENV APPIMAGE_EXTRACT_AND_RUN=1

RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
         -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/githubcli-archive-keyring.gpg /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends \
        gh docker-ce-cli docker-buildx-plugin docker-compose-plugin nodejs \
    && rm -rf /var/lib/apt/lists/*

# Cloudflare tunnel client, for publishing the box's web server (see box-supervisor.sh).
RUN curl -fsSL -o /tmp/cloudflared.deb \
      "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-$(dpkg --print-architecture).deb" \
    && dpkg -i /tmp/cloudflared.deb \
    && rm /tmp/cloudflared.deb \
    && cloudflared --version

# Nix, Rust, cargo tools and RISC0 are installed on demand by prime-box (see README), not at
# build time. These locations are set up front so tools resolve as soon as it has run.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    RISC0_HOME=/usr/local/risc0

RUN mkdir -p /ai-box

ENV HOME=/ai-box
RUN sed -i 's|^root:x:0:0:root:/root:|root:x:0:0:root:/ai-box:|' /etc/passwd \
    && test "$(getent passwd root | cut -d: -f6)" = /ai-box

ENV PATH="/ai-box/.local/bin:/usr/local/bin:/usr/local/cargo/bin:/usr/local/risc0/bin:/nix/var/nix/profiles/default/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"

RUN curl -fsSL https://claude.ai/install.sh | bash \
    && test -x /ai-box/.local/bin/claude \
    && /ai-box/.local/bin/claude --version

# $HOME is bind-mounted at runtime and shadows whatever the installer put there.
RUN CLAUDE_BIN="$(readlink -f /ai-box/.local/bin/claude)" \
    && test -x "${CLAUDE_BIN}" \
    && install -m 0755 "${CLAUDE_BIN}" /usr/local/bin/claude \
    && /usr/local/bin/claude --version

ENV CLAUDE_CONFIG_DIR=/ai-box/.claude

# $HOME is bind-mounted at runtime and shadows anything installed under it, so install the
# whole package (binary plus its bundled helpers) outside it and link codex onto PATH.
RUN curl -fsSL https://chatgpt.com/codex/install.sh \
      | CODEX_HOME=/opt/codex CODEX_INSTALL_DIR=/usr/local/bin sh \
    && /usr/local/bin/codex --version

ENV CODEX_HOME=/ai-box/.codex
ENV TERM=xterm-256color

# The container is the sandbox: grants workspace trust without an interactive dialog, so
# $HOME doubling as the workspace is fine (the trust check consults this first).
ENV CLAUDE_CODE_SANDBOXED=1

# Required to allow bypassPermissions while running as root; compared against exactly "1".
ENV IS_SANDBOX=1

# Policy-tier settings outrank user and project settings, so every session the daemon
# spawns runs with permissions bypassed, not just the daemon itself.
RUN mkdir -p /etc/claude-code \
    && printf '%s\n' '{"permissions":{"defaultMode":"bypassPermissions"}}' \
       > /etc/claude-code/managed-settings.json

# Managed memory, read by every session. Points into the context/ mount from compose, so it
# dangles until runtime.
RUN ln -sfn /opt/box-context/AGENTS.md /etc/claude-code/CLAUDE.md

# Same for Codex: the managed layer outranks the user's config.toml, so every thread the
# daemon spawns runs without approvals or Codex's own (bwrap) sandbox.
RUN mkdir -p /etc/codex \
    && printf '%s\n' 'approval_policy = "never"' 'sandbox_mode = "danger-full-access"' \
       > /etc/codex/managed_config.toml

# The compose service name, used in the login hints the daemons print.
ENV BOX_SERVICE=box

# Agents box-supervisor.sh runs in this image.
ENV BOX_AGENTS="claude codex"

COPY entrypoint.sh /usr/local/bin/box-entrypoint.sh
COPY prime-box.sh /usr/local/bin/prime-box
COPY claude-daemon.sh codex-daemon.sh box-supervisor.sh /usr/local/bin/
RUN chmod 0755 /usr/local/bin/box-entrypoint.sh /usr/local/bin/prime-box \
      /usr/local/bin/claude-daemon.sh /usr/local/bin/codex-daemon.sh /usr/local/bin/box-supervisor.sh
ENTRYPOINT ["/usr/local/bin/box-entrypoint.sh"]

WORKDIR /ai-box

# Runs the agents, the web server and the tunnel; restarts whichever one exits.
CMD ["box-supervisor.sh"]
