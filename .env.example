# Copy to .env (gitignored) and fill in what you need. Every line is optional.
# Loaded into every container (claude, codex, box); HOME, CLAUDE_CONFIG_DIR,
# CODEX_HOME and TERM are set by docker-compose.yml and cannot be overridden here.

# Name prefix for the boxes (<BOX_HOST>-claude, -codex, -box). `./box` fills it in
# from this machine's hostname; set it here to use something else.
# BOX_HOST=

# GitHub CLI / git over HTTPS
# GH_TOKEN=

# Git identity for commits made inside the box
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# Do NOT set ANTHROPIC_API_KEY: Remote Control needs claude.ai subscription
# OAuth, and an API key here overrides the login stored in ./claude-box.

# Do NOT set OPENAI_API_KEY either: Codex remote control needs the ChatGPT
# login stored in ./codex-box.
