# Copy to .env (gitignored) and fill in what you need. Every line is optional.
# Loaded into every container (claude, codex, box); HOME, CLAUDE_CONFIG_DIR,
# CODEX_HOME and TERM are set by docker-compose.yml and cannot be overridden here.

# Name prefix for the boxes (<BOX_HOST>-claude, -codex, -box). `./box` fills it in
# from this machine's hostname; set it here to use something else.
# BOX_HOST=

# Cloudflare tunnel token (Zero Trust -> Networks -> Tunnels). When set, every box
# started with this .env publishes its web server through that tunnel. One token is one
# tunnel: run a single box with it, or requests land on a random box.
# TUNNEL_TOKEN=

# Public hostname assigned to that tunnel (e.g. reports.example.com). The create-report
# skill uses it to build the links to published reports.
# WWW_DOMAIN=

# Port the box's web server listens on inside the container (default 8080).
# WEB_PORT=8080

# GitHub CLI / git over HTTPS
# GH_TOKEN=

# Git identity for commits made inside the box
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# Sign commits and tags made inside the box with the box's own SSH key (see README,
# "Signed commits"). The committer email must be verified on your GitHub account.
# GIT_SIGNING=1

# Do NOT set ANTHROPIC_API_KEY: Remote Control needs claude.ai subscription
# OAuth, and an API key here overrides the login stored in ./claude-box.

# Do NOT set OPENAI_API_KEY either: Codex remote control needs the ChatGPT
# login stored in ./codex-box.
