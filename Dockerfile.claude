FROM node:22-bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    dnsutils \
    fd-find \
    file \
    fzf \
    git \
    iproute2 \
    jq \
    less \
    libssl-dev \
    lsof \
    netcat-openbsd \
    openssh-client \
    pkg-config \
    procps \
    python3 \
    python3-pip \
    ripgrep \
    rsync \
    tmux \
    unzip \
    xz-utils \
    zip \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace \
    && chown -R node:node /workspace /home/node

USER node

ENV HOME=/home/node
ENV PATH="/home/node/.local/bin:/usr/local/bin:/usr/bin:/bin"

RUN curl -fsSL https://claude.ai/install.sh | bash \
    && test -x /home/node/.local/bin/claude \
    && /home/node/.local/bin/claude --version

USER root

RUN CLAUDE_BIN="$(readlink -f /home/node/.local/bin/claude)" \
    && test -x "${CLAUDE_BIN}" \
    && install -m 0755 "${CLAUDE_BIN}" /usr/local/bin/claude \
    && /usr/local/bin/claude --version

RUN chown -R node:node /home/node /workspace

USER node

ENV HOME=/home/node
ENV CLAUDE_CONFIG_DIR=/home/node/.claude
ENV PATH="/usr/local/bin:/home/node/.local/bin:/usr/bin:/bin"
ENV TERM=xterm-256color

WORKDIR /workspace

CMD ["claude", "remote-control", "--name", "claude-box"]
