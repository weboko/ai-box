FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs curl wget ca-certificates gnupg bash openssh-client \
    ripgrep jq less procps psmisc lsof iproute2 tmux sudo \
    unzip zip xz-utils file locales lsb-release \
    bubblewrap libseccomp2 uidmap dnsutils fd-find fzf netcat-openbsd rsync \
    build-essential gcc-14 g++-14 make cmake ninja-build pkg-config \
    autoconf automake libtool clang llvm libclang-dev \
    libssl-dev zlib1g-dev libzstd-dev liblz4-dev libsnappy-dev libbz2-dev \
    libpcsclite-dev python3 python3-dev python3-venv python3-pip \
    lcov libgomp1 \
    libfuse2t64 fuse3 libegl1 libopengl0 libglx0 libgl1 libglu1-mesa libvulkan1 \
    libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 \
    libdbus-1-3 fontconfig libfontconfig1 libfreetype6 libnss3 \
    xvfb x11-utils mesa-utils \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 14 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 14 \
    && update-alternatives --set gcc /usr/bin/gcc-14 \
    && update-alternatives --set g++ /usr/bin/g++-14

ENV APPIMAGE_EXTRACT_AND_RUN=1

RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
         -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/githubcli-archive-keyring.gpg /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends \
        gh docker-ce-cli docker-buildx-plugin docker-compose-plugin nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://install.determinate.systems/nix | sh -s -- install linux \
      --no-confirm \
      --init none \
      --extra-conf "experimental-features = nix-command flakes" \
      --extra-conf "extra-substituters = https://cache.nix.logos.co/public" \
      --extra-conf "extra-trusted-public-keys = public:l4HrXgL4nw246+LBh2SOJyhz64BoGegOYLheT/iIAPU= public:Z1wyVBEx8PHbXujYB52Mysv9Rd8rWIhyQ3bQyef9yy4=" \
      --extra-conf "fallback = true" \
      --extra-conf "max-jobs = auto" \
      --extra-conf "sandbox = false"
ENV PATH=/nix/var/nix/profiles/default/bin:$PATH

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile default --default-toolchain 1.97.1 \
    && rustup toolchain install 1.94.0 --profile default \
    && rustup toolchain install nightly --profile minimal --component rustfmt \
    && rustup component add clippy rustfmt \
    && rustup target add wasm32-unknown-unknown

ENV RISC0_HOME=/usr/local/risc0 \
    PATH=/usr/local/risc0/bin:$PATH
RUN curl -L https://risczero.com/install | bash \
    && mv /root/.risc0/bin/rzup /usr/local/bin/rzup \
    && rm -rf /root/.risc0 \
    && rzup install rust 1.94.1 \
    && rzup install cpp 2024.1.5 \
    && rzup install r0vm 3.0.5 \
    && rzup install cargo-risczero 3.0.5

RUN curl -L --proto '=https' --tlsv1.2 -sSf \
      https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall --no-confirm \
        just@1.56.0 \
        cargo-nextest@0.9.140 \
        taplo-cli@0.10.0 \
        cargo-machete@0.9.2 \
        cargo-deny@0.20.2 \
        cargo-leptos

RUN mkdir -p /workspace

ENV HOME=/root
ENV PATH="/root/.local/bin:/usr/local/bin:/usr/local/cargo/bin:/usr/local/risc0/bin:/nix/var/nix/profiles/default/bin:/usr/bin:/bin"

RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh \
    && test -x /root/.local/bin/codex \
    && /root/.local/bin/codex --version

RUN CODEX_BIN="$(readlink -f /root/.local/bin/codex)" \
    && test -x "${CODEX_BIN}" \
    && install -m 0755 "${CODEX_BIN}" /usr/local/bin/codex \
    && /usr/local/bin/codex --version

ENV CODEX_HOME=/root/.codex
ENV TERM=xterm-256color

WORKDIR /workspace

CMD ["codex", "remote-control", "start"]
