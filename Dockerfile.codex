FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Only what the Codex installer, codex-daemon.sh and basic repo work need.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git jq ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /codex-box

ENV HOME=/codex-box
RUN sed -i 's|^root:x:0:0:root:/root:|root:x:0:0:root:/codex-box:|' /etc/passwd \
    && test "$(getent passwd root | cut -d: -f6)" = /codex-box

ENV PATH="/codex-box/.local/bin:/usr/local/bin:/usr/bin:/bin"

# $HOME is bind-mounted at runtime and shadows anything installed under it, so install the
# whole package (binary plus its bundled helpers) outside it and link codex onto PATH.
RUN curl -fsSL https://chatgpt.com/codex/install.sh \
      | CODEX_HOME=/opt/codex CODEX_INSTALL_DIR=/usr/local/bin sh \
    && /usr/local/bin/codex --version

ENV CODEX_HOME=/codex-box/.codex
ENV TERM=xterm-256color

# The container is the sandbox. The managed layer outranks the user's config.toml, so every
# thread the daemon spawns runs without approvals or Codex's own (bwrap) sandbox.
RUN mkdir -p /etc/codex \
    && printf '%s\n' 'approval_policy = "never"' 'sandbox_mode = "danger-full-access"' \
       > /etc/codex/managed_config.toml

COPY entrypoint.sh /usr/local/bin/box-entrypoint.sh
COPY codex-daemon.sh /usr/local/bin/codex-daemon.sh
RUN chmod 0755 /usr/local/bin/box-entrypoint.sh /usr/local/bin/codex-daemon.sh
ENTRYPOINT ["/usr/local/bin/box-entrypoint.sh"]

WORKDIR /codex-box

CMD ["codex-daemon.sh"]
